# Optional: forwards submitted orders to an automation endpoint.
# Works with Zapier, Make, or any custom API that accepts JSON.
# If omitted, the site returns an order summary and hands off to Carousell.
ORDER_WEBHOOK_URL=

# Optional: archives generated quote records (Zapier, Make, or a custom API).
QUOTE_WEBHOOK_URL=

# Required for the /ops admin. Use one JSON entry per person.
# Generate a hash with: npm run admin:hash -- "your-password"
ADMIN_USERS=[{"id":"owner","name":"Owner","username":"owner","role":"owner","passwordHash":"scrypt:16384:8:1:replace-with-generated-hash"}]
ADMIN_SESSION_SECRET=

# Required for persistent order and quote storage on Vercel.
# Local development falls back to .data/admin.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push for new-order notifications. Generate with:
# npx web-push generate-vapid-keys
# Keep the private key server-only. The public key is passed to the admin UI
# from the server, so it does not need a NEXT_PUBLIC_ variable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
